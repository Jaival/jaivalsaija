  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write --list-different .",
    "test": "bun test",
    "code-quality": "bun run lint:strict && bun run type-check && bun run test && bun run format:check",
    "code-quality:fix": "bun run lint:fix && bun run format:fix",
    "pre-commit": "bun run code-quality:fix && bun run type-check",
    "clean": "rm -rf .next out dist",
    "cv:pdf": "bun scripts/cv-pdf.tsx"
  },
